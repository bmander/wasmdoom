{
  "name": "wasmdoom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python3 scripts/build.py",
    "dev": "python3 scripts/serve.py",
    "start": "python3 scripts/serve.py",
    "test": "node --test tests/wad.test.mjs && playwright test",
    "test:ai": "python3 scripts/test_worthy.py",
    "train": "python3 -m training.selfplay",
    "train:cook": "python3 -m training.cook",
    "train:start": "python3 scripts/start_training.py",
    "train:league": "python3 -m training.league",
    "train:evaluate": "python3 -m training.evaluate",
    "test:training": "python3 -m unittest discover -s tests -p 'test_*.py'"
  },
  "devDependencies": { "@playwright/test": "^1.58.2" }
}
